# Detect text automatically; keep binary assets byte-for-byte.
* text=auto
*.md text eol=lf
*.cs text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.inputactions text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.meta text eol=lf
*.asset text=auto eol=lf
*.mat text=auto eol=lf
*.anim text=auto eol=lf
*.controller text=auto eol=lf
*.scenetemplate text=auto eol=lf
*.shader text eol=lf
*.hlsl text eol=lf
*.shadergraph text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# LFS applies only to Unity source media, not documentation screenshots.
# Character classes also match uppercase file extensions.
UnityProject/Assets/**/*.[pP][nN][gG] filter=lfs diff=lfs merge=lfs -text
UnityProject/Assets/**/*.[jJ][pP][gG] filter=lfs diff=lfs merge=lfs -text
