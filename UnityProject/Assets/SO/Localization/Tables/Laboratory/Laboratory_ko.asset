  m_TableData:
  - m_Id: 6
    m_Localized: "\uBCF4\uC874 \uAE30\uAC04\uC774 \uC9C0\uB09C \uBCF4\uACE0\uAC00
      \uC815\uB9AC\uB418\uC5B4 \uB0A8\uC740 \uAE30\uB85D\uC73C\uB85C \uC774\uB3D9\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4
    m_Localized: "\uC694\uCCAD\uC744 \uBC18\uC601\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5
    m_Localized: "\uC694\uCCAD\uC744 \uBC18\uC601\uD558\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4.
      \uC0C1\uD0DC\uC640 \uC870\uAC74\uC744 \uD655\uC778\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 8
    m_Localized: "\uC800\uC7A5\uD558\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4. \uC774\uC804
      \uC800\uC7A5\uC744 \uC720\uC9C0\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7
    m_Localized: "\uC9C4\uD589\uC744 \uC800\uC7A5\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2
    m_Localized: "\uC9C4\uD589\uC744 \uBCC0\uACBD\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3
    m_Localized: "\uC9C4\uD589\uC744 \uBCC0\uACBD\uD558\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4.
      \uD604\uC7AC \uC0C1\uD0DC\uB294 \uC720\uC9C0\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1
    m_Localized: "{notice} \xB7 \uC124\uC815 \uC800\uC7A5 \uC2E4\uD328"
    m_Metadata:
      m_Items:
      - rid: 2444913683439288507
  - m_Id: 349
    m_Localized: "\uBCF4\uC870\uD615\uC774 \uC815\uBA74 \uC791\uC5C5 \uC704\uCE58\uC5D0
      \uC811\uADFC\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uC2DC\uC124 \uC774\uB3D9\xB7\uD68C\uC804\uC73C\uB85C
      \uACBD\uB85C\uB97C \uD655\uC778\uD558\uC138\uC694. \uAE30\uC874 \uC9C4\uD589\uACFC
      \uD22C\uC785 \uC0C1\uD0DC\uB294 \uBCF4\uC874\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 348
    m_Localized: "\uC644\uB8CC\uD488\uC774 \uC804\uB7C9 \uC800\uC7A5\uC18C\uC5D0
      \uB4E4\uC5B4\uAC00\uBA74 \uB2E4\uC74C \uD68C\uCC28\uAC00 \uC2DC\uC791\uB429\uB2C8\uB2E4.
      \uC6B4\uBC18\uC790\uAC00 \uC9D1\uC5B4 \uB4E0 \uAC83\uB9CC\uC73C\uB85C \uC644\uB8CC\uB418\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 327
    m_Localized: "\uBC30\uC815: {facility}"
    m_Metadata:
      m_Items:
      - rid: 2444913683439288507
  - m_Id: 328
    m_Localized: "\uBC30\uC815: {facility} \xB7 \uD604\uC7AC \uBC30\uC815"
    m_Metadata:
      m_Items:
      - rid: 2444913683439288507
  - m_Id: 325
    m_Localized: "\uBC30\uC815 \uC2DC\uC124: {facility}"
    m_Metadata:
      m_Items:
      - rid: 2444913683439288507
  - m_Id: 347
    m_Localized: "\uBC30\uC815 \uAC1C\uCCB4"
    m_Metadata:
      m_Items: []
  - m_Id: 355
    m_Localized: "\uBC30\uC815 \uC2DC\uC124\uACFC \uC2E4\uC81C \uD589\uB3D9\uC740
      \uB2E4\uB97C \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uC2DC\uC124\uC5D0\uC11C \uC791\uC5C5\uD560
      \uC218 \uC5C6\uC73C\uBA74 \uBC30\uC815\uC744 \uC720\uC9C0\uD55C \uCC44 \uB2E4\uB978
      \uC791\uC5C5\uC744 \uD569\uB2C8\uB2E4. \uC815\uC0C1 \uC6B4\uBC18\uC740 \uC644\uB8CC\uD55C
      \uB4A4 \uC0C8 \uBC30\uC815\uC73C\uB85C \uC804\uD658\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 112
    m_Localized: "\uAC74\uC124"
    m_Metadata:
      m_Items: []
  - m_Id: 154
    m_Localized: "{facility} \xB7 {resource} {count:N0}"
    m_Metadata:
      m_Items:
      - rid: 2444913683439288507
  - m_Id: 119
    m_Localized: "\uBD80\uC9C0\uB97C \uD655\uC815\uD558\uBA74 \uC790\uC7AC \uC6B4\uBC18
      \uD6C4 \uC2DC\uACF5\uD569\uB2C8\uB2E4. \uC790\uC7AC\uAC00 \uBD80\uC871\uD574\uB3C4
      \uBD80\uC9C0\uB97C \uC9C0\uC815\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 111
    m_Localized: "\uCDE8\uC18C"
    m_Metadata:
      m_Items: []
  - m_Id: 138
    m_Localized: "\uCDE8\uC18C \xB7 \uD604\uC7AC \uD310 \uC720\uC9C0"
    m_Metadata:
      m_Items: []
  - m_Id: 123
    m_Localized: "\uACB9\uCE5C \uB300\uC0C1 \uC120\uD0DD"
    m_Metadata:
      m_Items: []
  - m_Id: 363
    m_Localized: "\uC6B4\uBC18 \uAC1C\uCCB4"
    m_Metadata:
      m_Items: []
  - m_Id: 351
    m_Localized: "\uBC30\uC591 \uB300\uC0C1\uC744 \uC120\uD0DD\uD558\uBA74 \uD604\uC7AC
      \uD55C \uD68C\uCC28\uBD84\uC758 \uC7AC\uB8CC\uB97C \uACF5\uAE09\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 116
    m_Localized: "\uB2EB\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 102
    m_Localized: "\uC811\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 110
    m_Localized: "\uBC30\uCE58 \uD655\uC815"
    m_Metadata:
      m_Items: []
  - m_Id: 137
    m_Localized: "\uD655\uC778 \xB7 \uC9C4\uD589 \uBCC0\uACBD"
    m_Metadata:
      m_Items: []
  - m_Id: 341
    m_Localized: "\uC2DC\uACF5 \uC644\uB8CC \xB7 \uC2DC\uC124 \uC0AC\uC6A9 \uAC00\uB2A5"
    m_Metadata:
      m_Items: []
  - m_Id: 343
    m_Localized: "\uBD80\uC9C0\uB294 \uD655\uC815\uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      \uC790\uC7AC\uB97C \uC6B4\uBC18\xB7\uD22C\uC785\uD55C \uB4A4 \uBCF4\uC870\uD615\uC774
      \uC2DC\uACF5\uD569\uB2C8\uB2E4. \uC790\uC7AC \uBD80\uC871\uC740 \uAC74\uC124
      \uC644\uB8CC\uB97C \uB73B\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 303
    m_Localized: "\uAC74\uC124 \uC911 \xB7 \uC2DC\uACF5 {progress}\n\uC2DC\uACF5
      \uC644\uB8CC \uC804\uC5D0\uB294 \uC2DC\uC124\uC744 \uC0AC\uC6A9\uD560 \uC218
      \uC5C6\uC2B5\uB2C8\uB2E4."
