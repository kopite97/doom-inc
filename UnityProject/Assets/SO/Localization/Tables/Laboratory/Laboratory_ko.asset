      m_Items: []
  - m_Id: 380
    m_Localized: "\uC791\uC5C5 \uB300\uC0C1\uAE4C\uC9C0 \uC774\uB3D9\uD560 \uACBD\uB85C\uAC00
      \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 385
    m_Localized: "\uC790\uC6D0\uC744 \uBCF4\uC720 \uC911\uC774\uBA70 \uB3C4\uB2EC
      \uAC00\uB2A5\uD55C \uD5C8\uC6A9 \uC800\uC7A5 \uACF5\uAC04\uC774 \uC5C6\uC2B5\uB2C8\uB2E4."
