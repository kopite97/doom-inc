      m_Items: []
  - m_Id: 387
    m_Localized: "\uB2E4\uC74C \uC791\uC5C5\uC744 \uAE30\uB2E4\uB9BD\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 382
    m_Localized: "\uB3C4\uB2EC\uD560 \uC218 \uC788\uB294 \uC791\uC5C5 \uB610\uB294
      \uC720\uD6A8\uD55C \uC6B4\uBC18 \uBAA9\uC801\uC9C0\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4."
