  - m_Id: 118
    m_Localized: "\uAE00\uAF34 \uB77C\uC774\uC120\uC2A4\uB97C \uCC3E\uC744 \uC218
      \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 117
    m_Localized: "\uC800\uC7A5\uC744 \uBD88\uB7EC\uC624\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4.
      \uAC8C\uC784 \uBA54\uB274\uC5D0\uC11C \uC7AC\uC2DC\uB3C4\uD558\uC138\uC694."
