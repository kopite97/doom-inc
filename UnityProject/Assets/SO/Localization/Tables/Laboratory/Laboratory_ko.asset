      m_Items:
      - rid: 2444913683439288507
  - m_Id: 344
    m_Localized: "\uC9C4\uD589 \uC911 \uC120\uD0DD\uC744 \uBC14\uAFB8\uBA74 \uB2E4\uC74C
      \uD68C\uCC28\uBD80\uD130 \uC801\uC6A9\uB429\uB2C8\uB2E4. \uC644\uB8CC \uAC1C\uCCB4\uB294
      \uC791\uC5C5 \uC704\uCE58\uC5D0 \uC790\uB3D9\uC73C\uB85C \uB098\uD0C0\uB0A9\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 309
    m_Localized: "\uD604\uC7AC \uD68C\uCC28: {current}\n\uB2E4\uC74C \uD68C\uCC28:
      {next}"
    m_Metadata:
      m_Items:
      - rid: 2444913683439288507
