      m_Items: []
  - m_Id: 381
    m_Localized: "\uBAA8\uB4E0 \uC791\uC5C5 \uC6B0\uC120\uC21C\uC704\uAC00 \uAEBC\uC838
      \uC788\uC2B5\uB2C8\uB2E4."
