  - m_Id: 21
    m_Localized: "\uC0C8 \uD310\uC744 \uC2DC\uC791\uD558\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4.
      \uC800\uC7A5 \uC0C1\uD0DC\uB97C \uD655\uC778\uD558\uACE0 \uB2E4\uC2DC \uC2DC\uB3C4\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 3
    m_Localized: "\uD504\uB85C\uD1A0\uD0C0\uC785 1\uAC1C\uCCB4\uC640 \uCD08\uAE30
      \uC790\uC6D0\uC73C\uB85C \uC2DC\uC791\uD569\uB2C8\uB2E4. \uC800\uC7A5\uC5D0
      \uC131\uACF5\uD558\uBA74 \uC774\uC804 \uD310\uC744 \uCD08\uAE30 \uC0C1\uD0DC\uB85C
