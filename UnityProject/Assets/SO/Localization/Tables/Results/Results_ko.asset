      m_Items: []
  - m_Id: 12
    m_Localized: "\uC774\uC804 \uBC84\uC804\uC5D0\uC11C \uC885\uB8CC\uB41C \uD310\uC785\uB2C8\uB2E4.
      \uD65C\uB3D9 \uAE30\uB85D\uC740 \uB0A8\uC544 \uC788\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
