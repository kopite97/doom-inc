buffers { size_kb: 16384 fill_policy: RING_BUFFER }
duration_ms: 10000
data_sources {
  config { name: "android.surfaceflinger.frametimeline" }
}
data_sources {
  config {
    name: "linux.ftrace"
    ftrace_config {
      atrace_categories: "gfx"
      atrace_categories: "input"
      atrace_apps: "com.DefaultCompany.urp_2d"
    }
  }
}
data_sources {
  config {
    name: "linux.process_stats"
    process_stats_config { scan_all_processes_on_start: true proc_stats_poll_ms: 1000 }
  }
}
